# ─────────────────────────────────────────────────────────────────────────────
# SUNI environment template — copy to `.env` and fill in. NEVER commit `.env`.
# All values are placeholders; real secrets stay out of the repo.
# ─────────────────────────────────────────────────────────────────────────────

# ── Tuning Ollama (read this before setting any OLLAMA_* variable) ───────────
# Ollama is a SEPARATE service. Variables set here, or in SUNI's launcher, are
# inherited by SUNI's process only — they never reach an already-running Ollama
# server, so putting OLLAMA_* in this file does nothing. Set them where Ollama
# itself starts:
#   Linux (systemd):  sudo systemctl edit ollama
#                     [Service]
#                     Environment="OLLAMA_FLASH_ATTENTION=1"
#   macOS:            launchctl setenv OLLAMA_FLASH_ATTENTION 1
#   Windows:          set a User or System environment variable, then restart
#                     Ollama so it picks the value up
# Note that SUNI sends keep_alive per request, which overrides
# OLLAMA_KEEP_ALIVE for its own calls.

# ── Core ─────────────────────────────────────────────────────────────────────
# Base directory for all state (DBs, memory, config, index). Defaults to ./memory
# — set this to run isolated instances / multi-tenant deployments.
SUNI_DATA_DIR=./memory
SUNI_MODEL=qwen2.5:7b

# ── Email (optional — enables inbox watch + send_email tool) ─────────────────
SUNI_SMTP_HOST=smtp.example.com
SUNI_SMTP_PORT=587
SUNI_SMTP_USER=you@example.com
SUNI_SMTP_PASS=                      # app password — keep secret
SUNI_NOTIFY_TO=you@example.com
SUNI_IMAP_HOST=mail.example.com   # inbox host for the email watcher
SUNI_IMAP_PORT=993

# ── Messaging channels (optional — each gateway is off until its token is set) ─
TELEGRAM_BOT_TOKEN=                  # @BotFather
DISCORD_BOT_TOKEN=                   # Discord Developer Portal (Message Content intent ON)
SLACK_APP_TOKEN=                     # xapp-… (connections:write)
SLACK_BOT_TOKEN=                     # xoxb-… (chat:write)
TWILIO_AUTH_TOKEN=                   # WhatsApp webhook (needs a public URL)
SUNI_PUBLIC_URL=                     # only for webhook-mode channels

# ── SUNIverse article ingestion (optional, dev only — needs the SQL Server) ──
# Without these, /ingest-articles raises a clear "not configured" error; the
# rest of SUNI is unaffected.
SUNIVERSE_DB_HOST=                   # e.g. DBSERVER  (host only — port is separate)
SUNIVERSE_DB_PORT=1433
SUNIVERSE_DB_NAME=                   # the articles database
SUNIVERSE_DB_USER=
SUNIVERSE_DB_PASS=                   # keep secret
SUNIVERSE_DB_DRIVER={ODBC Driver 17 for SQL Server}

# ── OIDC / SSO (optional) ────────────────────────────────────────────────────
SUNI_OIDC_ISSUER=
SUNI_OIDC_CLIENT_ID=
SUNI_OIDC_CLIENT_SECRET=

# ── Embeddings backend (optional; defaults to local Ollama nomic-embed-text) ──
SUNI_EMBED_MODEL=nomic-embed-text
